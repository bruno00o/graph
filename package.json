{
  "name": "@bruno00o/graph",
  "version": "0.27.0",
  "description": "Framework-agnostic, typed graph visualization rendered with WebGL2.",
  "keywords": [
    "graph",
    "graph-visualization",
    "visualization",
    "webgl",
    "typescript",
    "maplibre",
    "tanstack-intent"
  ],
  "license": "MIT",
  "author": "bruno00o",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruno00o/graph.git"
  },
  "homepage": "https://bruno00o.github.io/graph/",
  "bugs": "https://github.com/bruno00o/graph/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./cypher": {
      "types": "./dist/cypher.d.ts",
      "import": "./dist/cypher.js"
    },
    "./formats": {
      "types": "./dist/formats.d.ts",
      "import": "./dist/formats.js"
    },
    "./layouts": {
      "types": "./dist/layouts.d.ts",
      "import": "./dist/layouts.js"
    },
    "./layouts/force": {
      "types": "./dist/layouts/force.d.ts",
      "import": "./dist/layouts/force.js"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js"
    },
    "./devtools/react": {
      "types": "./dist/devtools/react.d.ts",
      "import": "./dist/devtools/react.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js"
    },
    "./map/react": {
      "types": "./dist/map/react.d.ts",
      "import": "./dist/map/react.js"
    },
    "./minimap": {
      "types": "./dist/minimap.d.ts",
      "import": "./dist/minimap.js"
    },
    "./legend": {
      "types": "./dist/legend.d.ts",
      "import": "./dist/legend.js"
    },
    "./bundling": {
      "types": "./dist/bundling.d.ts",
      "import": "./dist/bundling.js"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "import": "./dist/shapes.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "vite",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:thumbnails": "node scripts/thumbnails.mjs",
    "docs:check-pages": "node scripts/check-pages.mjs",
    "docs:new-example": "node scripts/new-example.mjs",
    "docs:showcase-data": "node scripts/showcase-data.mjs",
    "bench": "node scripts/bench.mjs",
    "build": "tsdown",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browsers": "node scripts/browsers.mjs",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./theme.css",
    "lint:skills": "intent validate skills && node scripts/check-skills-publish.mjs",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm lint:skills && pnpm build && pnpm lint:package",
    "prepublishOnly": "intent validate skills --set-version $npm_package_version"
  },
  "dependencies": {
    "@mapbox/tiny-sdf": "2.3.0",
    "@tanstack/store": "0.11.2"
  },
  "peerDependencies": {
    "@tanstack/db": "^1.0.0-rc.1.3",
    "@tanstack/devtools": ">=0.16.0",
    "@tanstack/devtools-utils": ">=0.7.0",
    "@tanstack/query-core": "^5.0.0",
    "maplibre-gl": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/db": {
      "optional": true
    },
    "@tanstack/devtools": {
      "optional": true
    },
    "@tanstack/devtools-utils": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.5",
    "@tanstack/db": "1.0.0-rc.1.3",
    "@tanstack/devtools": "0.16.0",
    "@tanstack/devtools-utils": "0.7.2",
    "@tanstack/intent": "0.5.6",
    "@tanstack/query-core": "5.106.0",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-store": "0.11.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "maplibre-gl": "6.16.0",
    "neo4j-driver": "6.3.0",
    "playwright": "1.65.0",
    "publint": "0.3.25",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "rolldown": "1.2.16",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
