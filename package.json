{
  "name": "@bruno00o/graph",
  "version": "0.0.0",
  "description": "Framework-agnostic, typed graph visualization rendered with WebGL2.",
  "keywords": [
    "graph",
    "graph-visualization",
    "visualization",
    "webgl",
    "typescript"
  ],
  "license": "MIT",
  "author": "bruno00o",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruno00o/graph.git"
  },
  "homepage": "https://github.com/bruno00o/graph#readme",
  "bugs": "https://github.com/bruno00o/graph/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "bench": "node scripts/bench.mjs",
    "build": "tsdown",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./theme.css",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build && pnpm lint:package"
  },
  "dependencies": {
    "@mapbox/tiny-sdf": "2.3.0",
    "@tanstack/store": "0.11.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.5",
    "@tanstack/db": "1.0.0-rc.1.3",
    "@tanstack/react-store": "0.11.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.28.7",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
