{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "mdx"],
    "paths": {
      "@bruno00o/graph": ["../src/index.ts"],
      "@bruno00o/graph/react": ["../src/react/index.tsx"],
      "@bruno00o/graph/db": ["../src/db/index.ts"],
      "@bruno00o/graph/query": ["../src/query/index.ts"]
    }
  },
  "include": ["src", "source.config.ts", "vite.config.ts"]
}
