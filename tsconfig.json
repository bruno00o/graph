{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@bruno00o/graph": ["./src/index.ts"],
      "@bruno00o/graph/react": ["./src/react/index.tsx"],
      "@bruno00o/graph/db": ["./src/db/index.ts"],
      "@bruno00o/graph/query": ["./src/query/index.ts"],
      "@bruno00o/graph/layouts": ["./src/layouts/index.ts"],
      "@bruno00o/graph/layouts/force": ["./src/layouts/force/index.ts"],
      "@bruno00o/graph/devtools": ["./src/devtools/index.ts"],
      "@bruno00o/graph/devtools/react": ["./src/devtools/react.tsx"],
      "@bruno00o/graph/export": ["./src/export/index.ts"],
      "@bruno00o/graph/map": ["./src/map/index.ts"],
      "@bruno00o/graph/minimap": ["./src/minimap/index.ts"],
      "@bruno00o/graph/legend": ["./src/legend/index.ts"],
      "@bruno00o/graph/bundling": ["./src/bundling/index.ts"],
      "@bruno00o/graph/timeline": ["./src/timeline/index.ts"]
    }
  },
  "include": ["src", "examples"]
}
